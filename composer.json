{
    "name": "onoffice/sdk",
    "description": "Official client to communicate with the onOffice API",
    "license": "MIT",
    "require": {
        "php": ">=7.2.5",
        "ext-json": "*",
        "ext-curl": "*"
    },
    "autoload": {
        "psr-4": {
            "onOffice\\SDK\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\onOffice\\SDK\\": "tests"
        }
    },
    "require-dev": {
      "phpunit/phpunit": "^8",
      "friendsofphp/php-cs-fixer": "^2.16",
      "symfony/process": "^5.4.21"
    },
    "scripts": {
        "test-unit": [
            "phpunit -c phpunit.xml.dist --testsuite unit"
        ],
        "test-integration": [
            "phpunit -c phpunit.xml.dist --testsuite integration"
        ],
        "test": [
            "phpunit -c phpunit.xml.dist"
        ]
    }
}
